rules_version = '2';

// GreenGo Cloud Storage security rules.
//
// Replaces the previous fully-open dev rules (allow read,write: if true).
// Policy: uploads are authenticated + owner-scoped where the owner id is in the
// path; profile media is readable by signed-in users (discovery); PRIVATE chat,
// group and support media is readable/writable only by that chat's members
// (cross-service Firestore lookups, see "PRIVATE CHAT MEDIA" below);
// ID-verification images are readable ONLY by admins. Everything unmatched is
// denied.
// Admin = Firebase Auth custom claim `admin` (set via the admin migration).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // Accept only images/audio/video, capped at 50 MB (voice/video intros).
    function validUpload() {
      return request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    // Profile photos, voice intros, media — owner writes; signed-in users read
    // (needed for discovery/profile viewing).
    // INC-2026-001 / audit C-10 (lockdown doc §5): app versions before the
    // P1-4 split uploaded the onboarding ID selfie to
    // profiles/{uid}/verifications/. That sub-folder is owner/admin-only
    // (admins open it through getVerificationPhotoUrl). Storage ORs matching
    // rules, so the broad match must exclude it explicitly.
    match /profiles/{uid}/{allPaths=**} {
      allow read: if signedIn() && !allPaths.matches('verifications/.*');
      allow write: if isOwner(uid) && validUpload();
    }
    match /profiles/{uid}/verifications/{file=**} {
      allow read: if isOwner(uid) || isAdmin();
    }

    // Video profiles (video_profiles/{uid}/intro.mp4|thumbnail.jpg).
    match /video_profiles/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && validUpload();
    }

    // Voice intro re-recorded from Edit Profile (voice_intros/{uid}/...). Owner
    // writes; signed-in users read (profile playback). The onboarding path
    // profiles/{uid}/voice/... is already covered above.
    match /voice_intros/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && validUpload();
    }

    // Community images — the owner (community owner id in the path) writes.
    match /communities/{ownerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(ownerId) && validUpload();
    }

    // ID / verification images — keyed by the uploader's uid. The owner writes
    // AND may read them back (the reverification flow calls getDownloadURL right
    // after upload); admins read for review. Not readable by other users.
    match /verifications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && validUpload();
    }

    // Retained identity documents (moved here by submitAgeDocument / the
    // account-deletion cascade). Server-only: Cloud Functions use the Admin SDK,
    // which bypasses these rules. Nobody else may read or write them.
    match /id_documents/{allPaths=**} {
      allow read, write: if false;
    }
    match /retention/{allPaths=**} {
      allow read, write: if false;
    }

    // Data-subject exports (exportMyData, P3-2): exports/{uid}/{ts}.zip.
    // Server-only. The owner downloads through the 24 h signed URL the
    // function returns (signed URLs bypass rules); no client SDK access, so a
    // stolen ID token alone cannot list or fetch an export.
    match /exports/{allPaths=**} {
      allow read, write: if false;
    }

    // Age-assurance documents. WRITE-ONLY by design.
    //
    // The owner uploads an identity document here and the `submitAgeDocument`
    // function reads it with admin credentials, extracts the birth date, and
    // MOVES the image to the server-only id_documents/ prefix (retained for
    // fraud prevention) within the same invocation. Nobody — not the uploader,
    // not an admin — can read it back, because there is no legitimate reason
    // to and every reason not to: this is the most sensitive data the app
    // handles. Images are capped tighter than ordinary media since a document
    // photo has no business being 50 MB.
    match /age_verification/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // =====================================================================
    // PRIVATE CHAT MEDIA (audit H-06 / L-01, plan P1-3)
    //
    // Was: any signed-in user could read AND overwrite every chat / group /
    // support file, keyed only by a guessable id. Now each folder is readable
    // and writable ONLY by the members of the chat its first path segment
    // names, using cross-service Firestore lookups (firestore.get/exists).
    // The app's upload paths are unchanged, so every released app version
    // keeps working for legitimate members; only strangers are refused.
    //
    // DEPLOY PREREQUISITE: the Storage service agent
    //   service-<PROJECT_NUMBER>@gcp-sa-firebasestorage.iam.gserviceaccount.com
    // needs the role "Firebase Rules Firestore Service Agent"
    // (roles/firebaserules.firestoreServiceAgent). Without it every
    // firestore.get() below fails and chat-media uploads are denied.
    //
    // Limits: max 2 Firestore document reads per rules evaluation (Firebase
    // hard limit); each is billed as a Firestore read. Viewing media through
    // a tokenized download URL does NOT evaluate rules at all; only the
    // uploader's getDownloadURL() right after upload, uploads and deletes do.
    //
    // Ops: `get` (download / getDownloadURL) and `create` for members;
    // `list` is denied (the app never lists these folders); `update`
    // (overwriting an existing object or its metadata) is denied (the app
    // always writes a fresh uuid name); `delete` for members, restricted to
    // the uploader once the object carries customMetadata.uploaderId.
    // =====================================================================

    // Admin-panel staff (adminRole claim, mirrored from admin_users) or the
    // legacy `admin` claim. Free: no Firestore read.
    function isStaff() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
            || request.auth.token.get('adminRole', '') in ['superAdmin', 'moderator', 'support']);
    }

    // Same membership test as firestore.rules convMember(): the two 1:1
    // participants, a group participant, or the assigned support agent.
    function inConversation(c) {
      return request.auth.uid == c.get('userId1', '')
        || request.auth.uid == c.get('userId2', '')
        || (c.get('participants', []) is list
            && request.auth.uid in c.get('participants', []))
        || request.auth.uid == c.get('supportAgentId', '');
    }

    // Synthetic 1:1 chat keys carry both uids, so membership needs NO read:
    //   search_{a}_{b} (sorted) | bizsearch_{owner}_{customer}
    //   superlike_{sender}_{target} | gift_{a}_{b} (sorted)
    // Firebase Auth uids are [A-Za-z0-9]{28}, so '_' splits unambiguously.
    function isSyntheticChatKey(key) {
      return key.matches('^(search|bizsearch|superlike|gift)_.*');
    }
    function inSyntheticChat(key) {
      let p = key.split('_');
      return p.size() == 3 && (p[1] == request.auth.uid || p[2] == request.auth.uid);
    }

    // 1:1 media folders are keyed by ChatScreen.matchId = the conversation's
    // `matchId` FIELD. Besides the synthetic keys above it is either a
    // matches/{id} doc id (userId1/userId2) or, for legacy pushes whose
    // conversation had no matchId field, the conversations/{id} doc id.
    // At most 2 Firestore reads; a missing doc errors, which only denies.
    function isChatMember(key) {
      return request.auth != null && (
        isSyntheticChatKey(key)
          ? inSyntheticChat(key)
          : (inConversation(firestore.get(/databases/(default)/documents/matches/$(key)).data)
             || inConversation(firestore.get(/databases/(default)/documents/conversations/$(key)).data))
      );
    }

    // groups/{groupId}.participants (same source as firestore.rules).
    function isGroupMember(groupId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.participants;
    }

    // Support ticket = conversations/{conversationId} (userId1 = the user,
    // supportAgentId = the assigned agent), plus any support staff.
    function isSupportMember(conversationId) {
      return request.auth != null && (
        isStaff()
        || inConversation(firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data)
        || firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid))
      );
    }

    // Uploads may only create NEW objects: an upload onto an existing name is
    // refused even when the rules engine classifies it as `create` (the
    // Storage emulator does), so nobody can replace someone else's media.
    function isNewObject() {
      return resource == null;
    }

    // Optional uploader stamp. Today's app does not set it (accepted); a
    // client that DOES set customMetadata.uploaderId must set its own uid.
    function uploaderStampOk() {
      return request.resource.metadata == null
        || request.resource.metadata.get('uploaderId', request.auth.uid) == request.auth.uid;
    }
    // Delete: when the object carries an uploaderId only that user (or
    // staff) may delete it; legacy objects (no stamp) any member may delete
    // (the app deletes its own just-uploaded image when moderation rejects it).
    function deleterOk() {
      return isStaff()
        || resource.metadata == null
        || resource.metadata.get('uploaderId', request.auth.uid) == request.auth.uid;
    }

    // Content-type allow-lists (lowercased) + per-folder size caps sized to
    // the app's real usage. No application/*, text/*, or image/svg+xml
    // (SVG/HTML can run script when a download URL is opened).
    function mb(n) { return n * 1024 * 1024; }
    function isChatImage(maxMb) {
      return request.resource.size <= mb(maxMb)
        && request.resource.contentType.lower().matches('image/(jpeg|jpg|pjpeg|png|gif|webp|heic|heif)');
    }
    function isChatAudio(maxMb) {
      return request.resource.size <= mb(maxMb)
        && request.resource.contentType.lower().matches('audio/(mp4|m4a|x-m4a|aac|mpeg|mp3|ogg|opus|webm|wav|x-wav|wave|3gpp|amr)');
    }
    // 1:1 video sends `video/<file extension>` (mp4, mov, 3gp, ...), so the
    // subtype is not a fixed list; any video/* is accepted, never other types.
    function isChatVideo(maxMb) {
      return request.resource.size <= mb(maxMb)
        && request.resource.contentType.lower().matches('video/.+');
    }

    // 1:1 chat images: app downsizes to <=1200px and compresses (~300 KB
    // target), falling back to the 1200px original. 10 MB cap.
    match /chat_images/{chatKey}/{allPaths=**} {
      allow get: if isChatMember(chatKey) || isStaff();
      allow create: if isChatMember(chatKey) && isChatImage(10) && uploaderStampOk() && isNewObject();
      allow delete: if isChatMember(chatKey) && deleterOk();
    }
    // 1:1 voice notes: AAC-LC 128 kbps m4a (~1 MB/min), `audio/mp4`. 20 MB.
    match /chat_voice/{chatKey}/{allPaths=**} {
      allow get: if isChatMember(chatKey) || isStaff();
      allow create: if isChatMember(chatKey) && isChatAudio(20) && uploaderStampOk() && isNewObject();
      allow delete: if isChatMember(chatKey) && deleterOk();
    }
    // 1:1 video: the app refuses files > 50 MB and records <= 60 s.
    match /chat_videos/{chatKey}/{allPaths=**} {
      allow get: if isChatMember(chatKey) || isStaff();
      allow create: if isChatMember(chatKey) && isChatVideo(50) && uploaderStampOk() && isNewObject();
      allow delete: if isChatMember(chatKey) && deleterOk();
    }

    // Group media: image/jpeg (full-resolution re-encode at q80, so several
    // MB on high-MP cameras: 20 MB cap) or video/mp4 (no client cap; 50 MB,
    // the same ceiling the old rule had).
    match /group_media/{groupId}/{allPaths=**} {
      allow get: if isGroupMember(groupId) || isStaff();
      allow create: if isGroupMember(groupId)
        && (isChatImage(20) || isChatVideo(50)) && uploaderStampOk() && isNewObject();
      allow delete: if isGroupMember(groupId) && deleterOk();
    }
    match /group_voice/{groupId}/{allPaths=**} {
      allow get: if isGroupMember(groupId) || isStaff();
      allow create: if isGroupMember(groupId) && isChatAudio(20) && uploaderStampOk() && isNewObject();
      allow delete: if isGroupMember(groupId) && deleterOk();
    }

    // Support-chat attachments: images only (1920px q85 => well under 10 MB).
    match /support_attachments/{conversationId}/{allPaths=**} {
      allow get: if isSupportMember(conversationId);
      allow create: if isSupportMember(conversationId) && isChatImage(10) && uploaderStampOk() && isNewObject();
      allow delete: if isSupportMember(conversationId) && deleterOk();
    }

    // Link-mode ticket payment receipts (functions/src/ticket_payments/):
    // ticket_receipts/{orderId}/{file}. The BUYER uploads one image (<= 5 MB)
    // while the order waits for payment / confirmation; the buyer and the
    // listing ORGANIZER (and staff) can read it. Moderated as a private image
    // (moderateUploadedImage). Never overwritten, never client-deleted.
    match /ticket_receipts/{orderId}/{fileName} {
      function ticketOrder() {
        return firestore.get(/databases/(default)/documents/ticket_orders/$(orderId)).data;
      }
      allow get: if isStaff()
        || (signedIn()
            && (ticketOrder().buyerId == request.auth.uid
                || ticketOrder().organizerId == request.auth.uid));
      allow create: if signedIn()
        && ticketOrder().buyerId == request.auth.uid
        && ticketOrder().status in ['pending_payment', 'awaiting_confirmation']
        && isChatImage(5)
        && uploaderStampOk()
        && isNewObject();
      allow update, delete: if false;
    }

    // Business verification document — owner (userId in path) writes; the owner
    // and admins can read it back (owner needs to display upload status).
    match /business_verification/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && validUpload();
    }

    // Pronunciation TTS cache — shared, keyed by language/phrase. Any signed-in
    // user may populate it and read it (it's non-sensitive generated audio).
    match /pronunciation_audio/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && validUpload();
    }

    // Quarantined images: content the moderateUploadedImage trigger rejected.
    // Admin read ONLY, and no client may write here - the trigger moves files
    // in with the Admin SDK, which bypasses these rules. Uploading content is
    // rejected, not destroyed, so a false positive stays recoverable; but the
    // whole point is that it is no longer reachable by users.
    match /quarantine/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else: denied (no more open bucket). Add a match above for any
    // new upload path before shipping it.
  }
}
