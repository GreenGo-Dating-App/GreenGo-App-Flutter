<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>firebase_performance_collection_enabled</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GreenGo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GreenGo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad is portrait-only, matching the runtime lock in main.dart
	     (setPreferredOrientations portraitUp/portraitDown). The app's screens
	     are designed for a portrait phone; landscape on a 13" iPad pushed the
	     login button under the keyboard (App Store 2.1 rejection).
	     UIRequiresFullScreen is required for this list to be honoured at all:
	     a multitasking-capable iPad app has its supported orientations
	     ignored by the system. Opting out of multitasking is the cost. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Maps API Key (loaded from Secrets.xcconfig) -->
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Location -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GreenGo uses your location while you use the app to show nearby events, places and people, and approximate distances. Others never see your exact location.</string>
	<!-- Camera -->
	<key>NSCameraUsageDescription</key>
	<string>GreenGo uses the camera when you choose to take profile, chat or event photos, scan a QR code, or photograph your ID for age verification.</string>
	<!-- Microphone -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GreenGo needs microphone access to record voice messages.</string>
	<!-- Photo Library -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GreenGo accesses the photos and videos you choose to share on your profile, in chats, communities and events.</string>
	<!-- Push Notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- Custom URL scheme: greengo://u/{userId} and greengo://e/{eventId}.
	     (Universal Links via https are declared in Runner.entitlements.) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.greengochat.greengochatapp.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>greengo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
